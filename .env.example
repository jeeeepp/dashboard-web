# Copy to .env for local runs (python-dotenv loads it automatically).
# On Render (or any host), set these in the dashboard's own Environment
# tab instead -- never commit real credentials.

DASHBOARD_USERNAME=changeme
DASHBOARD_PASSWORD=changeme

# Passive full-universe refresh cadence, in minutes. See README.md's
# rate-limit-safeguards section for why 30-60 is the recommended range.
REFRESH_INTERVAL_MIN=45

# Minimum seconds between manual "Refresh now" clicks (single-flight lock
# handles overlap; this only guards against rapid back-to-back clicks).
REFRESH_COOLDOWN_SEC=120

# Safety net: if a scan hasn't finished within this many seconds, give up
# waiting and free the UI/lock so a retry can start (a stalled network call
# has no timeout of its own otherwise -- see app.py's SCAN_TIMEOUT_SEC
# comment). ~120s measured locally; free-tier hosts can be much slower, so
# 600 (10min) leaves real headroom before assuming a hang.
SCAN_TIMEOUT_SEC=600
